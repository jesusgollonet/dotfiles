{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "ttf",
  "title": "ttf",
  "description": "Jump to a project's tmux session, creating it and starting its dev server if needed.",
  "icon": "command-icon.png",
  "author": "jesusgollonet",
  "license": "MIT",
  "commands": [
    {
      "name": "projects",
      "title": "Open Project",
      "subtitle": "ttf",
      "description": "List projects and tmux sessions, Enter switches to or creates the session.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "ttfPath",
      "title": "ttf path",
      "description": "Path to the ttf script.",
      "type": "textfield",
      "required": false,
      "default": "~/.dotfiles/bin/ttf"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.8.2",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "typecheck": "tsc --noEmit"
  }
}
