#!/bin/bash
# Session identity is a bright accent on a consistent, readable dark bar.
COLOURS="$(cd "$(dirname "${BASH_SOURCE[0]}")/../config" && pwd)/colours"

main() {
  local session_id colour_number num_colours colour_index label
  session_id="${1:-$(tmux display-message -p '#{session_id}')}"
  [ -n "$session_id" ] || exit 1
  num_colours=$(wc -l <"$COLOURS" | awk '{print $1}')
  colour_index=$((1 + ${session_id#\$} % num_colours))
  colour_number=$(sed "${colour_index}!d" "$COLOURS")

  # Replace legacy per-session backgrounds as well as setting the new defaults.
  tmux set -t "$session_id" status-bg colour234
  tmux set -t "$session_id" status-fg colour252
  label="#[bg=colour234,fg=colour${colour_number},bold] [#S] #[default] "
  if [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}${MOSH_CONNECTION:-}" ] || tmux show-environment -t "$session_id" 2>/dev/null | grep -qE "^(SSH_(CONNECTION|CLIENT|TTY)|MOSH_CONNECTION)="; then
    label="#[bg=colour160,fg=colour255,bold] REMOTE #[default] $label"
  fi
  tmux set -t "$session_id" status-left-length 50
  tmux set -t "$session_id" status-left "$label"
}

main "$@"
